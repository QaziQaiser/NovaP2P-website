# ---------------------------------------------------------------------------
# SERVER-ONLY SETTINGS (set these in Hostinger > Environment variables)
# ---------------------------------------------------------------------------

# REQUIRED: Admin passkey for /swap-admin and the signed email review links.
# Admin features stay locked until this is set. Use a long random value.
SWAP_ADMIN_KEY=""

# REQUIRED for emails: password of the support@novap2p.com Hostinger mailbox.
# Used to email new Partner/BDM applications to the admin and decisions to applicants.
SMTP_PASS=""
# Optional overrides (defaults shown)
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_USER="support@novap2p.com"
# ADMIN_NOTIFICATION_EMAIL="support@novap2p.com"

# Public site URL used in email links (defaults to the request host)
# APP_URL="https://novap2p.com"

# Recommended: folder OUTSIDE the deploy directory for the SQLite database,
# so redeploys never wipe applications, affiliates and rewards.
# DATA_DIR="/home/<hostinger-user>/novap2p-data"
