{
  "name": "novap2p-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --outfile=server/dist-server.js --packages=external",
    "postinstall": "npm run build",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
