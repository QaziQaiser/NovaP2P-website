    "@lifi/widget-provider-ethereum": "^4.1.10",
    "@lifi/widget-provider-solana": "^4.1.10",
    "@lifi/widget-provider-sui": "^4.1.10",
    "@lifi/widget-provider-tron": "^4.1.9",
    "@mysten/dapp-kit-react": "^2.1.44",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.105.0",
    "@tronweb3/tronwallet-adapter-react-hooks": "^1.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@wagmi/core": "^3.6.7",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "better-sqlite3": "^12.4.1",
